{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intruvia v1 contracts",
  "$ref": "#/$defs/event",
  "$defs": {
    "sequence": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
      "maxLength": 19,
      "description": "Decimal signed 64-bit integer, maximum 9223372036854775807; event sequences are positive."
    },
    "geoStatus": {
      "enum": [
        "FOUND",
        "NOT_FOUND",
        "NON_PUBLIC",
        "UNAVAILABLE",
        "ERROR"
      ]
    },
    "event": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "$ref": "#/$defs/eventSequence"
        },
        "source": {
          "type": "object",
          "properties": {
            "type": {
              "const": "fail2ban"
            },
            "instanceId": {
              "type": "string"
            },
            "eventId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "type",
            "instanceId",
            "eventId"
          ],
          "additionalProperties": false
        },
        "category": {
          "const": "network.security"
        },
        "action": {
          "const": "ban"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "receivedAt": {
          "type": "string",
          "format": "date-time"
        },
        "subject": {
          "type": "object",
          "properties": {
            "ip": {
              "type": "string",
              "description": "Canonical IPv4 or IPv6 literal"
            }
          },
          "required": [
            "ip"
          ],
          "additionalProperties": false
        },
        "observer": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "attributes": {
          "type": "object",
          "properties": {
            "fail2ban": {
              "type": "object",
              "properties": {
                "jail": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                },
                "failures": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 2147483647
                }
              },
              "required": [
                "jail"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "fail2ban"
          ],
          "additionalProperties": false
        },
        "geo": {
          "type": "object",
          "properties": {
            "countryCode": {
              "type": [
                "string",
                "null"
              ]
            },
            "countryName": {
              "type": [
                "string",
                "null"
              ]
            },
            "region": {
              "type": [
                "string",
                "null"
              ]
            },
            "city": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "databaseEdition": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/geoStatus"
            },
            "latitude": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -180,
              "maximum": 180
            },
            "accuracyRadiusKm": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "databaseBuildAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "lookedUpAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "description": "Coordinates must be both non-null or both absent/null; zero coordinates are valid.",
          "oneOf": [
            {
              "required": [
                "latitude",
                "longitude"
              ],
              "properties": {
                "latitude": {
                  "type": "number"
                },
                "longitude": {
                  "type": "number"
                }
              }
            },
            {
              "properties": {
                "latitude": {
                  "type": "null"
                },
                "longitude": {
                  "type": "null"
                }
              }
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "sequence",
        "source",
        "category",
        "action",
        "occurredAt",
        "receivedAt",
        "subject",
        "observer",
        "attributes",
        "geo"
      ],
      "additionalProperties": false
    },
    "fail2banRequest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "action": {
          "const": "ban"
        },
        "ip": {
          "type": "string"
        },
        "jail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "failures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "schemaVersion",
        "eventId",
        "occurredAt",
        "action",
        "ip",
        "jail"
      ],
      "additionalProperties": false
    },
    "fail2banResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "$ref": "#/$defs/eventSequence"
        },
        "duplicate": {
          "type": "boolean"
        },
        "geoStatus": {
          "$ref": "#/$defs/geoStatus"
        }
      },
      "required": [
        "id",
        "sequence",
        "duplicate"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "duplicate": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "geoStatus"
        ]
      },
      "else": {
        "not": {
          "required": [
            "geoStatus"
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "requestId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "eventSequence": {
      "allOf": [
        {
          "$ref": "#/$defs/sequence"
        },
        {
          "pattern": "^[1-9][0-9]*$"
        }
      ]
    }
  }
}
