# Standalone nginx config. Replace hostname and certificate paths before use.
worker_processes 1;
error_log /var/log/nginx/error.log crit;
pid /tmp/intruvia-nginx.pid;
events { worker_connections 1024; }
http {
	access_log off;
	map $http_upgrade $connection_upgrade { default upgrade; '' close; }
	limit_conn_zone $binary_remote_addr zone=clients:1m;
	limit_req_zone $binary_remote_addr zone=requests:1m rate=100r/s;
	server {
		listen 443 ssl;
		server_name intruvia.example.org;
		ssl_certificate /etc/intruvia/tls/fullchain.pem;
		ssl_certificate_key /etc/intruvia/tls/key.pem;
		ssl_protocols TLSv1.2 TLSv1.3;
		client_max_body_size 16k;
		client_body_timeout 15s;
		client_header_timeout 15s;
		keepalive_timeout 30s;
		limit_conn clients 100;
		limit_req zone=requests burst=200 nodelay;
		limit_req_status 429;
		location /health/ { return 404; }
		location / {
			proxy_pass http://127.0.0.1:8080;
			proxy_http_version 1.1;
			proxy_set_header Host $host;
			proxy_set_header Upgrade $http_upgrade;
			proxy_set_header Connection $connection_upgrade;
			proxy_buffering off;
			proxy_connect_timeout 5s;
			proxy_read_timeout 75s;
			proxy_send_timeout 15s;
		}
	}
}
