# Set the published, versioned image reference when building the release bundle.
INTRUVIA_IMAGE=
# Exact HTTP or HTTPS origin, with no path, trailing slash, credentials, query, or fragment.
# Use HTTPS for exposed deployments; http://localhost is suitable for certificate-free local testing.
INTRUVIA_PUBLIC_ORIGIN=
POSTGRES_ADMIN_USERNAME=intruvia_admin
POSTGRES_ADMIN_PASSWORD=
INTRUVIA_DB_NAME=intruvia
INTRUVIA_DB_USERNAME=intruvia
INTRUVIA_DB_PASSWORD=