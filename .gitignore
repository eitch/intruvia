# Java and Maven build output (all modules)
target/
*.class
*.jar
*.war
*.ear
*.nar
# Keep the Maven Wrapper distributable if added.
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# IDE and editor metadata
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.factorypath
.metadata/
.vscode/
nbproject/private/
nbbuild/
nbdist/
.gradletasknamecache
*.swp
*.swo
*~
*.orig
*.rej

# JVM diagnostics and application logs
*.log
*.log.*
logs/
hs_err_pid*
replay_pid*
*.hprof
*.jfr

# Local environment and credentials; retain documented templates
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.jks
*.keystore
*.p12
*.pfx
/.secrets/
/secrets/

# Local runtime and database files; do not ignore src/**/runtime templates
/runtime/
/data/
/backups/
/tmp/
/temp/
*.mmdb
GeoIP.conf

# Optional frontend tooling output
node_modules/
coverage/
.nyc_output/

# Operating-system files
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.Trash-*/

# Backlog runner coordination
.next-task.lock
