<StrolchConfiguration>
	<env id="production">
		<Runtime><applicationName>Intruvia</applicationName></Runtime>
		<Component>
			<name>PrivilegeHandler</name>
			<api>li.strolch.runtime.privilege.PrivilegeHandler</api>
			<impl>li.strolch.runtime.privilege.DefaultStrolchPrivilegeHandler</impl>
			<Properties><privilegeConfigFile>PrivilegeConfig.xml</privilegeConfigFile></Properties>
		</Component>
		<Component>
			<name>SessionHandler</name>
			<api>li.strolch.runtime.sessions.StrolchSessionHandler</api>
			<impl>li.strolch.runtime.sessions.DefaultStrolchSessionHandler</impl>
			<depends>PrivilegeHandler</depends>
			<Properties>
				<session.ttl.minutes>30</session.ttl.minutes>
				<session.maxKeepAlive.minutes>30</session.maxKeepAlive.minutes>
			</Properties>
		</Component>
		<Component>
			<name>PersistenceHandler</name>
			<api>li.strolch.persistence.api.PersistenceHandler</api>
			<impl>li.strolch.persistence.postgresql.PostgreSqlPersistenceHandler</impl>
			<Properties>
				<db.useEnv>true</db.useEnv>
				<db.pool.connectionTimeout>3000</db.pool.connectionTimeout>
				<db.pool.validationTimeout>2000</db.pool.validationTimeout>
				<allowSchemaCreation>false</allowSchemaCreation>
				<allowSchemaMigration>false</allowSchemaMigration>
				<allowSchemaDrop>false</allowSchemaDrop>
				<allowDataInitOnSchemaCreate>false</allowDataInitOnSchemaCreate>
			</Properties>
		</Component>
		<Component>
			<name>RealmHandler</name>
			<api>li.strolch.agent.api.RealmHandler</api>
			<impl>li.strolch.agent.impl.DefaultRealmHandler</impl>
			<depends>PrivilegeHandler</depends>
			<depends>PersistenceHandler</depends>
			<Properties>
				<realms>defaultRealm</realms>
				<dataStoreMode>CACHED</dataStoreMode>
				<enableAuditTrail>true</enableAuditTrail>
			</Properties>
		</Component>
		<Component>
			<name>MigrationsHandler</name>
			<api>li.strolch.migrations.MigrationsHandler</api>
			<impl>li.strolch.migrations.MigrationsHandler</impl>
			<depends>RealmHandler</depends>
			<Properties><runMigrationsOnStart>false</runMigrationsOnStart><pollMigrations>false</pollMigrations></Properties>
		</Component>
		<Component>
			<name>GeoIp</name>
			<api>li.intruvia.core.geo.GeoIpComponent</api>
			<impl>li.intruvia.core.geo.GeoIpComponent</impl>
			<!-- Optional absolute City MMDB path. Empty/missing file means degraded enrichment. -->
			<Properties><databasePath></databasePath></Properties>
		</Component>
		<Component>
			<name>ServiceHandler</name>
			<api>li.strolch.service.api.ServiceHandler</api>
			<impl>li.strolch.service.api.DefaultServiceHandler</impl>
			<depends>PrivilegeHandler</depends>
			<depends>RealmHandler</depends>
		</Component>
		<Component>
			<name>Intruvia</name>
			<api>li.intruvia.core.IntruviaComponent</api>
			<impl>li.intruvia.core.IntruviaComponent</impl>
			<depends>MigrationsHandler</depends>
		</Component>
		<Component>
			<name>Retention</name>
			<api>li.intruvia.core.retention.RetentionComponent</api>
			<impl>li.intruvia.core.retention.RetentionComponent</impl>
			<depends>Intruvia</depends>
			<depends>ServiceHandler</depends>
			<Properties>
				<eventAgeSeconds>2592000</eventAgeSeconds>
				<eventCapacity>100000</eventCapacity>
				<receiptAgeSeconds>2592000</receiptAgeSeconds>
				<receiptCapacity>1000000</receiptCapacity>
				<sweepSeconds>86400</sweepSeconds>
			</Properties>
		</Component>
		<Component>
			<name>StreamNotifications</name>
			<api>li.intruvia.core.persistence.EventStreamNotifications</api>
			<impl>li.intruvia.core.persistence.EventStreamNotifications</impl>
		</Component>
		<Component>
			<name>EventStream</name>
			<api>li.intruvia.rest.stream.EventStreamComponent</api>
			<impl>li.intruvia.rest.stream.EventStreamComponent</impl>
			<depends>Intruvia</depends>
			<depends>ServiceHandler</depends>
			<depends>SessionHandler</depends>
			<depends>StreamNotifications</depends>
			<Properties>
				<queueFrames>1000</queueFrames>
				<messageBytes>65536</messageBytes>
				<sendSeconds>10</sendSeconds>
				<pollMillis>250</pollMillis>
			</Properties>
		</Component>
	</env>
</StrolchConfiguration>
